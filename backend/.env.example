# ============================================================
# PawsForward — Environment Variables Template
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file: cp .env.example .env
#   2. Fill in YOUR actual values in .env
#   3. NEVER commit .env to git (it's in .gitignore)
#
# Why? .env contains secrets (passwords, API keys).
# .env.example is the SAFE version — a template with no real values.
# Your teammates clone the repo, copy this file, and fill in their own.
# ============================================================

# --- PostgreSQL Connection ---
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/pawsforward

# --- Application Settings ---
APP_ENV=development   # Options: development | production
DEBUG=true

# --- Future: ChromaDB (Phase 3) ---
# CHROMA_HOST=localhost
# CHROMA_PORT=8001

# --- Future: Redis / Celery (Phase 3) ---
# REDIS_URL=redis://localhost:6379/0
